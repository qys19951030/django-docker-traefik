# 生产环境环境变量示例文件
# 使用方法：
#   1. 复制本文件为 .env.prod（不要改名 .env，避免 docker-compose.yml 开发链路误读）
#   2. 把下面的 SECRET_KEY 替换成你自己真实的密钥
#   3. 修改 DJANGO_ALLOWED_HOSTS / DJANGO_CSRF_TRUSTED_ORIGINS 等域名
#   4. 启动时指定：
#        docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#      或者直接在 shell 里：
#        SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(64))") \
#        docker compose -f docker-compose.prod.yml up -d --build

# ⚠️ 下面这行 SECRET_KEY 只是占位/格式示例，绝不能在生产里直接使用！
# 仓库中出现过的任何 SECRET_KEY 示例值都会被 Django 启动阶段拒绝。
# 请用以下命令生成你自己的：
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE-ME-WITH-YOUR-OWN-SECRET-KEY-GENERATED-WITH-SECRETS-TOKEN_URLSAFE-64-OR-EQUIVALENT

DEBUG=0
DJANGO_ALLOWED_HOSTS=django-traefik.your-domain.com,.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://django-traefik.your-domain.com,https://*.your-domain.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1
DATABASE_URL=postgresql://django_traefik:django_traefik@db:5432/django_traefik
